  },
  {
   "cell_type": "code",
   "execution_count": 16,
   "id": "2f3802be",
   "metadata": {},
   "outputs": [
    {
     "name": "stdout",
     "output_type": "stream",
     "text": [
      "Success Probability of obtaining 10 over Grover iterations\n",
      "                  0       1       2\n",
      "ideal         0.246   1.000   0.246\n",
      "gates         0.246   0.917   0.246\n",
      "readout       0.243   0.946   0.243\n",
