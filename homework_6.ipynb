    "print(qiskit.__version__)\n",
    "print(qiskit_aer.__version__)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 50,
   "id": "81df7915",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Magic numbers\n",
    "OPT_LEVEL = 0\n",
    "SHOTS = 4096\n",
    "SEED = 7\n",
    "LAM1, LAM2 = 0.005, 0.02\n",
    "P = 0.03\n",
    "\n",
    "# default collections\n",
    "NOISE = (\"ideal\", \"gates\", \"readout\", \"combined\")\n",
    "BASIS_1Q = ['h','x','z','s','sdg','ry','rz','id']\n",
    "BASIS_2Q = ['cx']\n",
    "BASIS = BASIS_1Q + BASIS_2Q"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 118,
   "id": "8144b1f1",
   "metadata": {},
   "outputs": [],
   "source": [
    "# helper functions\n",
    "def add_noise(kind: str):\n",
    "    # add noise to the AerSimulator\n",
    "    nm = NoiseModel()\n",
    "    if kind in (\"gates\", \"combined\"):\n",
    "        nm.add_all_qubit_quantum_error(depolarizing_error(LAM1, 1), BASIS_1Q)\n",
    "        nm.add_all_qubit_quantum_error(depolarizing_error(LAM2, 2), BASIS_2Q)\n",
    "    if kind in (\"readout\", \"combined\"):\n",
    "        nm.add_all_qubit_readout_error(ReadoutError([[1 - P, P],[P, 1 - P]]))\n",
    "    return nm\n",
    "\n",
    "def run(q: QuantumCircuit, \n",
    "        noise: str, \n",
    "        shots: int = SHOTS, \n",
    "        seed: int = SEED, \n",
    "        opt_level: int = OPT_LEVEL):\n",
    "    # run the thing\n",
    "    sim = AerSimulator(method=\"density_matrix\",\n",
    "                       noise_model= add_noise(noise),\n",
    "                       basis_gates=BASIS)\n",
    "    tqc = transpile(q, sim, optimization_level=opt_level, seed_transpiler=seed)\n",
    "    result = sim.run(tqc, shots=shots, seed_simulator=seed).result()\n",
    "    return result, tqc\n",
    "\n",
    "def print_table(results, title, dec=3, gap=3):\n",
    "    cols = list(next(iter(results.values())).keys())\n",
    "    labw = max(len(str(label)) for label in results) + gap\n",
    "    colw = {c: max(len(str(c)), max(len(f\"{row[c]:.{dec}f}\") for row in results.values())) + gap\n",
    "            for c in cols}\n",
    "\n",
    "    print(title)\n",
    "    print(f\"{'':<{labw}}\" + \"\".join(f\"{str(c):>{colw[c]}}\" for c in cols))\n",
    "    for label, row in results.items():\n",
    "        print(f\"{str(label):<{labw}}\" + \"\".join(f\"{row[c]:>{colw[c]}.{dec}f}\" for c in cols))\n",
    "    print()"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "a91e2735",
   "metadata": {},
   "source": [
    "# Part A: Quantum Teleportation"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 52,
   "id": "0962bb61",
   "metadata": {},
   "outputs": [],
   "source": [
    "PROBES = {\n",
    "    \"0\": [],\n",
    "    \"1\": [XGate()],\n",
    "    \"+\": [HGate()],\n",
    "    \"-\": [XGate(), HGate()],\n",
    "    \"+i\": [HGate(), SGate()],\n",
    "    \"-i\": [HGate(), SdgGate()]\n",
    "}\n",
    "\n",
    "# get the preparation and inverse-preparation stuff\n",
    "def get_prep_circuits(probe):\n",
    "    prep = QuantumCircuit(1, name=\"prep\")\n",
    "    for gate in PROBES[probe]:\n",
    "        prep.append(gate, [0])\n",
    "    post = prep.inverse()\n",
    "    post.name = \"post\"\n",
    "    return prep, post\n",
    "\n",
    "def entangle():\n",
    "    e = QuantumCircuit(2, name=\"entangle\")\n",
    "    e.h(0)\n",
    "    e.cx(0, 1)\n",
    "    return e\n",
    "\n",
    "def quantum_teleportation(probe, bob_corrects=True):\n",
    "    # q0 = unknown state, q1 = alice qubit, q2 = bob qubit\n",
    "    # bob_corrects is whether bob will correct his qubit\n",
    "    q = QuantumCircuit(3, 3)\n",
    "\n",
    "    # prepare qubit\n",
    "    prep, post = get_prep_circuits(probe)\n",
    "    q.append(prep, [0])\n",
    "    q.barrier()\n",
    "\n",
    "    # alice and bob share e-pair\n",
    "    q.append(entangle(), [1, 2])\n",
    "    q.barrier()\n",
    "    \n",
    "    # start quantum tele\n",
    "    q.cx(0, 1)\n",
    "\n",
    "    # alice measure\n",
    "    # q0 -> c0 and q1 -> c1\n",
    "    q.h(0)\n",
    "    q.measure(0, 0)\n",
    "    q.measure(1, 1)\n",
    "\n",
    "    # bob corrects\n",
    "    if bob_corrects:\n",
    "        with q.if_test((q.clbits[0], 1)):\n",
    "            q.z(2)\n",
    "        with q.if_test((q.clbits[1], 1)):\n",
    "            q.x(2)\n",
    "    q.barrier()\n",
    "\n",
    "    # post-processing + measure\n",
    "    # q2 -> c2, success if c2 = 0\n",
    "    q.append(post, [2])\n",
    "    q.measure(2, 2)\n",
    "    return q"
   ]
  },
