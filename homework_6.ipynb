   "source": [
    "# Part B: Superdense Coding"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": 59,
   "id": "c110fd77",
   "metadata": {},
   "outputs": [],
   "source": [
    "TWO_QUBITS = [\"00\", \"01\", \"10\", \"11\"]\n",
    "\n",
    "def entangle():\n",
    "    e = QuantumCircuit(2, name=\"entangle\")\n",
    "    e.h(0)\n",
    "    e.cx(0, 1)\n",
    "    return e\n",
    "\n",
    "def superdense_coding(message):\n",
    "    # q[0] = alice qubit, q[1] = bob qubit\n",
    "    q = QuantumCircuit(2, 2)\n",
    "    q.append(entangle(), [0, 1])\n",
    "    q.barrier()\n",
    "\n",
    "    # alice performs ops depending on the message\n",
    "    if message[0] == \"1\":\n",
    "        q.z(0)\n",
    "    if message[1] == \"1\":\n",
    "        q.x(0)\n",
    "\n",
    "    # alice sends to bob\n",
    "    q.barrier()\n",
    "\n",
    "    # bob performs bell measurement\n",
    "    # q0 -> c1, q1 -> c0\n",
    "    q.cx(0, 1)\n",
    "    q.h(0)\n",
    "    q.measure(0, 1) # flip the order since q0 determines phase flip\n",
    "    q.measure(1, 0)\n",
    "    return q"
   ]
  },
